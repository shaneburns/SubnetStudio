{
  "name": "subnetstudio",
  "version": "0.0.2-alpha",
  "description": "Visual IPv4 subnetting tool",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run backend:dev\" \"npm run dev\"",
    "backend:dev": "tsx watch server/index.ts",
    "backend:start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "npm run typecheck:app && npm run typecheck:server",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bulma": "^1.0.4",
    "dotenv": "^18.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-react": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.5",
    "vitest": "^4.1.9"
  }
}
