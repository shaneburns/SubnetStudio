# Normalize line endings to LF in the repo, check out as LF everywhere
* text=auto eol=lf

# Explicitly text files
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Binaries — never touch line endings
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary
*.woff  binary
