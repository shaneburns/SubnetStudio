# Local automation backend
# Leave NODE_ENV unset (or set to development) for verbose client-facing diagnostics.
# Set NODE_ENV=production to redact provider/config details from client responses.
AUTOMATION_SERVER_HOST=127.0.0.1
AUTOMATION_SERVER_PORT=8787
AUTOMATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# TypeSafe server-side credentials
TYPESAFE_API_KEY=replace-me
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
